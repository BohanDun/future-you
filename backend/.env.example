APP_ENV=development
APP_PORT=8000

FRONTEND_URL=http://localhost:5173

# Mock mode: mock/mock/mock. AWS mode: bedrock/dynamodb/cognito.
# Avoid mixing values unless you are deliberately testing one adapter.
AI_MODE=mock
DATA_SOURCE=mock
AUTH_MODE=mock

# Choose one authentication method. SSO/profile is recommended for local development.
AWS_PROFILE=
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

AWS_REGION_NAME=ap-southeast-2
COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
USER_PROFILE_TABLE_NAME=future-you-users

DYNAMODB_CUSTOMER_TABLE=future-you-customers
DYNAMODB_SIMULATION_TABLE=future-you-simulations
# Secret used to bind a Manage preview to its confirmed operation. Use 32+ random characters.
AGENT_PROPOSAL_SIGNING_KEY=

# Optional. Mock profiles are persisted here; defaults to backend/.local/mock-customers.
FUTURE_YOU_MOCK_STATE_DIR=
