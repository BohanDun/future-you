AI_MODE=bedrock
AWS_REGION_NAME=ap-southeast-2
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0

# Authentication option 1: an AWS profile, including IAM Identity Center/SSO.
# AWS_PROFILE=future-you

# Authentication option 2: export a Bedrock API key in your shell.
# Do not commit the real key:
# export AWS_BEARER_TOKEN_BEDROCK='your-api-key'
